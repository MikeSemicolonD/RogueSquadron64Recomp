# cmake -DSRC=<repo root> -DPATCHES=<co-op instruction_patches.json> -DOUT=<dir> -P web_regen.cmake
# The browser build can't apply a mod's instruction patches at runtime, so the co-op relocation is recompiled in. Writes into OUT:
#   coop_relocation.toml     the patches as N64Recomp [[patches.instruction]] entries
#   rogue_squadron.web.toml  rogue_squadron.toml with absolute paths, output in RecompiledFuncsWeb/ and the extra patch file
#   (in RecompiledFuncsWeb/) moved_ranges.inl and multiplayer_native.mod.json, the co-op mod's manifest for the browser's mod folder
foreach(v SRC PATCHES OUT)
    if (NOT ${v})
        message(FATAL_ERROR "web_regen.cmake needs ${v}")
    endif()
endforeach()

file(MAKE_DIRECTORY "${OUT}")

file(READ "${PATCHES}" json)
string(JSON count LENGTH "${json}" instruction_patches)
set(toml "# Generated by tools/mods/web_regen.cmake from multiplayer-native's instruction_patches.json.\n")
math(EXPR last "${count} - 1")

foreach(i RANGE ${last})
    string(JSON func GET "${json}" instruction_patches ${i} func)
    string(JSON vram GET "${json}" instruction_patches ${i} vram)
    string(JSON value GET "${json}" instruction_patches ${i} value)
    string(APPEND toml "\n[[patches.instruction]]\nfunc = \"${func}\"\nvram = ${vram}\nvalue = ${value}\n")
endforeach()

file(WRITE "${OUT}/coop_relocation.toml" "${toml}")

file(READ "${SRC}/rogue_squadron.toml" config)
string(REGEX REPLACE "\nelf_path = \"([^\"]*)\"" "\nelf_path = \"${SRC}/\\1\"" config "${config}")
string(REGEX REPLACE "\nrom_file_path = \"([^\"]*)\"" "\nrom_file_path = \"${SRC}/\\1\"" config "${config}")
string(REGEX REPLACE "\noutput_func_path = \"[^\"]*\"" "\noutput_func_path = \"${SRC}/RecompiledFuncsWeb\"" config "${config}")
string(REGEX REPLACE "\npatch_files = \\[\"([^\"]*)\"\\]" "\npatch_files = [\"${SRC}/\\1\", \"${OUT}/coop_relocation.toml\"]" config "${config}")

if (NOT config MATCHES "coop_relocation.toml" OR NOT config MATCHES "RecompiledFuncsWeb")
    message(FATAL_ERROR "rogue_squadron.toml no longer has the patch_files or output_func_path line web_regen.cmake rewrites")
endif()

file(WRITE "${OUT}/rogue_squadron.web.toml" "${config}")

file(READ "${SRC}/mods/multiplayer-native/src/core/mp_core.h" core)
string(REGEX MATCH "kMovedRanges\\[\\] = \\{([^;]*)\\};" found "${core}")

if (NOT found)
    message(FATAL_ERROR "mp_core.h has no single-line kMovedRanges for web_regen.cmake to read")
endif()

file(MAKE_DIRECTORY "${SRC}/RecompiledFuncsWeb")

# The browser build has no RecompModTool; it takes the co-op mod's mod.json from here.
get_filename_component(patches_dir "${PATCHES}" DIRECTORY)
file(COPY_FILE "${patches_dir}/mod.json" "${SRC}/RecompiledFuncsWeb/multiplayer_native.mod.json" ONLY_IF_DIFFERENT)

file(WRITE "${SRC}/RecompiledFuncsWeb/moved_ranges.inl" "// Generated by tools/mods/web_regen.cmake from kMovedRanges in mp_core.h: { lo, hi, delta }.\n${CMAKE_MATCH_1}\n")
