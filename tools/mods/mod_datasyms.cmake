# cmake -DIN=<datasyms.toml> -DOUT=<datasyms.mods.toml> -P mod_datasyms.cmake
# Writes the data symbols .nrm mods link against: IN with every symbol inside the co-op relocated ranges moved to its host RAM address.
# The ranges and deltas mirror kMovedRanges in src/main/lockstep_core.h; change both together.
set(ranges
    0x80138058 0x80138268 0x00A00000
    0x80138268 0x80138838 0x00A00000
    0x80138930 0x80138D10 0x00A20000
    0x80138E5C 0x80139020 0x00A00000)

file(READ "${IN}" text)
string(REGEX MATCHALL "vram = 0x8013[89][0-9A-F]+ }" hits "${text}")
list(REMOVE_DUPLICATES hits)
list(LENGTH ranges range_words)
math(EXPR last "${range_words} - 1")

set(moved 0)
foreach(hit IN LISTS hits)
    string(REGEX REPLACE "vram = (0x[0-9A-F]+) }" "\\1" addr "${hit}")
    math(EXPR a "${addr}")
    foreach(i RANGE 0 ${last} 3)
        math(EXPR j "${i} + 1")
        math(EXPR k "${i} + 2")
        list(GET ranges ${i} lo)
        list(GET ranges ${j} hi)
        list(GET ranges ${k} delta)
        math(EXPR lo "${lo}")
        math(EXPR hi "${hi}")
        if (a GREATER_EQUAL lo AND a LESS hi)
            math(EXPR new "${a} + ${delta}" OUTPUT_FORMAT HEXADECIMAL)
            string(TOUPPER "${new}" new)
            string(REPLACE "0X" "0x" new "${new}")
            string(REPLACE "${hit}" "vram = ${new} }" text "${text}")
            math(EXPR moved "${moved} + 1")
            break()
        endif()
    endforeach()
endforeach()

if (moved EQUAL 0)
    message(FATAL_ERROR "mod_datasyms: no symbols fell in the relocated ranges of ${IN}")
endif()
string(REPLACE "# Autogenerated from an ELF via N64Recomp\n" "# Generated by tools/mods/mod_datasyms.cmake from rogue_squadron.datasyms.toml: the data symbols for .nrm mods, with the co-op relocated fields at their host RAM addresses.\n" text "${text}")
file(WRITE "${OUT}" "${text}")
message(STATUS "mod_datasyms: moved ${moved} symbols into host RAM")
